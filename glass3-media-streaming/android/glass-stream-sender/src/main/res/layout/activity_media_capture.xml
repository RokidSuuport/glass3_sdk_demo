<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/videoEnabled"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:checked="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/startButton"
                android:nextFocusRight="@id/audioEnabled"
                android:text="@string/capture_video_enabled"
                android:textColor="#E8F1FA"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/audioEnabled"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:checked="true"
                android:focusable="true"
                android:nextFocusDown="@id/startButton"
                android:nextFocusLeft="@id/videoEnabled"
                android:text="@string/capture_audio_enabled"
                android:textColor="#E8F1FA"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusRight="@id/stopButton"
                android:nextFocusDown="@id/startRecordingButton"
                android:text="@string/start_capture"
                android:textSize="15sp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:enabled="false"
                android:focusable="true"
                android:nextFocusLeft="@id/startButton"
                android:nextFocusRight="@id/saveFrameButton"
                android:nextFocusDown="@id/startRecordingButton"
                android:text="@string/stop_capture"
                android:textSize="15sp" />

            <Button
                android:id="@+id/saveFrameButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:enabled="false"
                android:focusable="true"
                android:nextFocusLeft="@id/stopButton"
                android:nextFocusDown="@id/startRecordingButton"
                android:text="@string/save_current_frame"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startRecordingButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:enabled="false"
                android:focusable="true"
                android:nextFocusUp="@id/stopButton"
                android:nextFocusRight="@id/stopRecordingButton"
                android:nextFocusDown="@id/videoEnabled"
                android:text="@string/start_recording"
                android:textSize="14sp" />

            <Button
                android:id="@+id/stopRecordingButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:focusable="true"
                android:nextFocusUp="@id/stopButton"
                android:nextFocusLeft="@id/startRecordingButton"
                android:nextFocusRight="@id/playRecordingButton"
                android:nextFocusDown="@id/audioEnabled"
                android:text="@string/stop_recording"
                android:textSize="14sp" />

            <Button
                android:id="@+id/playRecordingButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:focusable="true"
                android:nextFocusUp="@id/saveFrameButton"
                android:nextFocusLeft="@id/stopRecordingButton"
                android:nextFocusRight="@id/stopPlaybackButton"
                android:nextFocusDown="@id/videoEnabled"
                android:text="@string/play_recording"
                android:textSize="14sp" />

            <Button
                android:id="@+id/stopPlaybackButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:focusable="true"
                android:nextFocusUp="@id/saveFrameButton"
                android:nextFocusLeft="@id/playRecordingButton"
                android:nextFocusDown="@id/audioEnabled"
                android:text="@string/stop_playback"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#39D0C3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/actionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D2DFEC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/videoMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#9CB1C7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/audioMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#9CB1C7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/recordingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#D2DFEC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/snapshotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D2DFEC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/playbackStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D2DFEC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/wavPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#8AC7FF"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/jpegPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#8AC7FF"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/localFileMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFB86B"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/errorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FF8080"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

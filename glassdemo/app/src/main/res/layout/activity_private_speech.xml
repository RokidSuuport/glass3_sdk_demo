<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="独立ASR/TTS"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="这是独立部署在眼镜端的在线 ASR/TTS 应用，通过 Online-Speech 实现。用户也可通过 OpenSdkAudioSource 修改输入音源，并部署到其他 Android 系统。"
        android:textColor="#BDBDBD"
        android:textSize="11sp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_private_speech"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#111111"
        app:tabIndicatorColor="#1E88E5"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabTextColor="#BBBBBB" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_private_speech"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_private_speech_log"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#101010"
        android:padding="6dp"
        android:scrollbars="vertical"
        android:textColor="#DDDDDD"
        android:textSize="11sp" />

</LinearLayout>

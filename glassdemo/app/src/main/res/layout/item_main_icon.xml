<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="88dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:clipToPadding="false"
    android:paddingTop="20dp">

    <LinearLayout
        android:id="@+id/main_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/home_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/main_icon_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            tools:src="@mipmap/icon_face_recog" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/item_sperate_line" />

        <TextView
            android:id="@+id/main_icon_name_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="3"
            android:paddingHorizontal="4dp"
            android:textColor="@color/green"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="SDK photo/video" />

        <ImageView
            android:id="@+id/item_main_select_bar"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/item_select_bar"
            android:visibility="invisible" />

    </LinearLayout>

</FrameLayout>

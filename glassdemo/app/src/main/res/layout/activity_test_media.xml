<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btPhoto480P"
            android:layout_width="50dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_select_bg"
            android:text="P480P"
            android:textColor="@color/green"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btPhoto720P"
            android:layout_width="50dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="P720P"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintLeft_toRightOf="@id/btPhoto480P"
            app:layout_constraintTop_toTopOf="@id/btPhoto480P" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btPhoto1080P"
            android:layout_width="50dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="P1080P"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintLeft_toRightOf="@+id/btPhoto720P"
            app:layout_constraintTop_toTopOf="@id/btPhoto480P" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btPhoto1080PLand"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="1080P_Land"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintLeft_toRightOf="@+id/btPhoto1080P"
            app:layout_constraintTop_toTopOf="@id/btPhoto480P" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btPhoto4K"
            android:layout_width="50dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="P4K"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintLeft_toRightOf="@+id/btPhoto1080PLand"
            app:layout_constraintTop_toTopOf="@id/btPhoto480P" />

        <!--                 <androidx.appcompat.widget.AppCompatButton-->

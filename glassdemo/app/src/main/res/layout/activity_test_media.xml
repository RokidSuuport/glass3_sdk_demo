        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btStartRecord720P"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_unselect_bg"
            android:text="Record720P"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/btPhoto480P"
            app:layout_constraintTop_toBottomOf="@id/btPhoto4K" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btStartRecord1080P"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="Record1080P"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/btStartRecord720P"
            app:layout_constraintTop_toTopOf="@id/btStartRecord720P" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btStartRecord1080PLand"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:paddingHorizontal="10dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Record1080PLand"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/btStartRecord1080P"
            app:layout_constraintTop_toTopOf="@id/btStartRecord720P" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btStopRecord"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_unselect_bg"
            android:text="StopRecord"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/btPhoto480P"
            app:layout_constraintTop_toBottomOf="@id/btStartRecord720P" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btSendVideo"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_unselect_bg"
            android:text="SendVideo"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/btPhoto480P"
            app:layout_constraintTop_toBottomOf="@id/btStopRecord" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btStopSendVideo"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="StopSendVideo"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/btSendVideo"
            app:layout_constraintTop_toTopOf="@id/btSendVideo" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetZoom"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="SetZoom"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/btStopSendVideo"
            app:layout_constraintTop_toTopOf="@id/btSendVideo" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRecordAudio"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_unselect_bg"
            android:text="采集音频"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/btPhoto480P"
            app:layout_constraintTop_toBottomOf="@id/btnSetZoom" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStopRecordAudio"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_unselect_bg"
            android:text="停止采集音频"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/btnRecordAudio"
            app:layout_constraintTop_toBottomOf="@id/btnSetZoom" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAiChat"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/round_unselect_bg"
            android:text="AI Chat"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@id/btPhoto480P"
            app:layout_constraintTop_toBottomOf="@id/btnRecordAudio" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStopAiChat"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/round_unselect_bg"
            android:text="Stop AI Chat"
            android:textAllCaps="false"
            android:textColor="@color/btn_text_selector"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/btnAiChat"
            app:layout_constraintTop_toTopOf="@id/btnAiChat" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clMedia">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:textColor="@color/green"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_parent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/glass_base_item_margin_bottom"
        android:singleLine="true"
        android:textColor="@color/common_text_color_selector"
        android:textSize="@dimen/glass_base_item_title_text_size"
        android:textStyle="bold" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/item_title"
        android:layout_centerHorizontal="true"
        android:layout_margin="@dimen/glass_base_item_content_margin" />

    <com.rokid.glass.component.GradientColorTextView
        android:id="@+id/item_label"
        android:layout_width="@dimen/glass_base_item_label_width"
        android:layout_height="@dimen/glass_base_item_label_width"
        android:layout_alignTop="@id/item_content"
        android:layout_marginStart="@dimen/glass_base_item_label_margin"
        android:layout_marginTop="@dimen/glass_base_item_label_margin_top"
        android:background="@mipmap/ic_round_black"
        android:gravity="center"
        android:textSize="@dimen/glass_base_item_label_text_size" />
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.rokid.glass.qrcode.GlassScanActivity">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="800px"
        android:layout_height="840px"
        android:layout_marginStart="-160px"
        android:layout_marginTop="-200px" />

    <com.king.view.viewfinderview.ViewfinderView
        android:id="@+id/viewfinderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:vvFrameRatio="0.62"
        app:vvLabelText="将二维码放入框内，距离一个手臂之内"
        app:vvLabelTextLocation="bottom"
        app:vvLabelTextSize="13sp"
        app:vvLaserStyle="grid"
        app:vvMaskColor="#ff000000" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        tools:text="标题"
        android:textColor="@color/green_50"
        android:textSize="13sp" />


</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">
    <ScrollView
        android:id="@+id/controlsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scrollView"
        app:layout_constraintVertical_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/demo_device_tools"
                android:textColor="@color/green"
                android:textSize="16sp"
                android:padding="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btQRCodeImage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="@string/demo_read_qr_code_image"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btQRCode"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="@string/demo_scan_qr_code"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btQRCodeXml"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="@string/demo_scan_qr_code_xml"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btConnectWifi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="@string/demo_connect_wi_fi_2"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btDisconnectWifi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="@string/demo_disconnect_wi_fi_2"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btConfigureAppVisibility"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="@string/demo_app_display_settings"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnAiChat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:singleLine="false"
                    android:text="@string/demo_ai_chat"
                    android:textColor="@color/green_70"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnStopAiChat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:singleLine="false"
                    android:text="@string/demo_stop_ai_chat"
                    android:textColor="@color/green_70"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnRegisterLeqi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:singleLine="false"
                    android:text="@string/device_leqi_register"
                    android:textColor="@color/green_70"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnSendCusEvent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:singleLine="false"
                    android:text="@string/device_send_cus_event"
                    android:textColor="@color/green_70"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnRecordAudio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:singleLine="false"
                    android:text="@string/demo_capture_audio"
                    android:textColor="@color/green_70"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnStopRecordAudio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:minLines="1"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:singleLine="false"
                    android:text="@string/demo_stop_audio_capture"
                    android:textColor="@color/green_70"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="64dp"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlsScrollView"
        android:padding="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green_normal_60"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

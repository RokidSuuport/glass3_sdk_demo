<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">
    <ScrollView
        android:id="@+id/controlsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scrollView"
        app:layout_constraintVertical_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/speechControlsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/ttsModeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnTtsQueueMode"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_select_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/message_tts_mode_add"
                        android:textColor="@color/green"
                        android:textSize="12sp"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnOnlineAsr"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_online_asr_2"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/onlineTtsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnOnlineTts"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_online_tts_2"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnStopOnlineTts"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/message_tts_stop_online"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/offlineTtsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnOfflineTts"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_offline_tts"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnStopOfflineTts"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/message_tts_stop_offline"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:orientation="vertical"
                android:paddingBottom="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/wfSendTextBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_send_p2p_text"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/wfSendFileBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_send_p2p_file"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/wfStopFileBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_stop_p2p_file"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btSendTextBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_send_bluetooth_text"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btSendFileBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_send_bluetooth_file"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btStopFileBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_stop_bluetooth_file"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btSendAudioStream"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_send_audio_stream"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btStopSendAudioStream"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:layout_height="match_parent"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_stop_sending_audio"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btSendVideo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_send_video"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btStopSendVideo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:minHeight="28dp"
                        android:minLines="1"
                        android:background="@drawable/round_unselect_bg"
                        android:gravity="center"
                        android:paddingHorizontal="3dp"
                        android:paddingVertical="2dp"
                        android:text="@string/demo_stop_sending_video"
                        android:textColor="@color/green_normal_40"
                        android:textSize="12sp"
                        android:ellipsize="none"
                        android:singleLine="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="64dp"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlsScrollView"
        android:padding="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green_normal_60"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" ?>
<resources>
    <style name="MediaActionButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">42dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:background">@drawable/round_unselect_bg</item>
        <item name="android:textColor">@color/green_70</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">none</item>
    </style>
</resources>

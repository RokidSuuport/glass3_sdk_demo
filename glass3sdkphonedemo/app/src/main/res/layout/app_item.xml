<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/appImage"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_width="30dp"
            android:layout_height="30dp"/>

        <TextView
            android:id="@+id/appName"
            android:text="appName"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/appImage"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:textColor="#1D1D1D"/>

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/switchBox"
            android:checked="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:kswThumbWidth="20dp"
            app:kswThumbHeight="20dp"
            app:kswThumbRangeRatio="2.2"
            app:kswThumbColor="#ffffff"
            app:kswBackDrawable="@drawable/switch_back_drawable"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <View
        android:background="#E8E8E8"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>

</LinearLayout>
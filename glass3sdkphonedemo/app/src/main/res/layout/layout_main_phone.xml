                <!--                    app:layout_constraintTop_toBottomOf="@id/bt_guide">-->


                <!--                    &lt;!&ndash; 内部控件保持不变 &ndash;&gt;-->
                <!--                    <ImageView-->
                <!--                        android:id="@+id/iv_ai_assistant"-->
                <!--                        android:layout_width="50dp"-->
                <!--                        android:layout_height="50dp"-->
                <!--                        android:padding="6dp"-->
                <!--                        android:src="@mipmap/icon_ai_assistant"-->

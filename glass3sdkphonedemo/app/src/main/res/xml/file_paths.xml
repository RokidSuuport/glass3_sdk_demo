<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 配置可共享的文件路径，根据实际需求添加 -->

    <!-- 1. 应用内部存储的 files 目录 -->
    <files-path
        name="my_files"
    path="." />  <!-- "." 表示整个 files 目录 -->

    <!-- 2. 应用内部存储的 cache 目录 -->
    <cache-path
        name="my_cache"
        path="." />

    <!-- 3. 外部存储的根目录（需申请存储权限） -->
    <external-path
        name="external_storage"
        path="." />

    <!-- 4. 外部存储中应用私有目录（推荐，无需额外权限） -->
    <external-files-path
        name="external_app_files"
        path="." />

    <!-- 对应 Context.getExternalFilesDir() -->
    <external-path
        name="external_files"
        path="." />
</paths>
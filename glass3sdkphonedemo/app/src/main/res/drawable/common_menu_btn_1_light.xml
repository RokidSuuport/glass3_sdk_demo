<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态（selected） -->
    <item android:drawable="@drawable/common_menu_btn_1_disabled" android:state_enabled="false" />

    <!-- 按下状态（pressed） -->
    <item android:drawable="@drawable/common_menu_btn_1_pressed" android:state_pressed="true" />

    <!-- 选中状态（selected） -->
    <item android:drawable="@drawable/common_menu_btn_1_pressed" android:state_selected="true" />

    <!-- 默认状态（normal） -->
    <item android:drawable="@drawable/common_menu_btn_1_normal" />
</selector>

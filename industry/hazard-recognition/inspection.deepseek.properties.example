# 用例：复制为 inspection.properties 后填写自己的 Key；已有文件时直接编辑，避免覆盖。
# 以下为 DeepSeek 视觉接入示例，模型可用性以客户账号为准。
endpoint=https://api.deepseek.com/chat/completions
model=deepseek-v4-flash-vision-exp
# 在本机填写客户自己的 DeepSeek API Key；此处故意留空，不提交真实密钥。
apiKey=
# 每秒本地采样目标，范围 1–3，不代表每秒推理次数。
sampleFps=3
# 修改本机配置后需重新构建安装。配置会进入 APK，带真实密钥的 APK 仅用于私有演示。
# 接入客户其他模型时参考 inspection.properties.example 和 README.md。
